+/**
+ * mipi_dsi_device_transfer_multi - submit multiple packets as one transaction
+ * @dsi: DSI peripheral device
+ * @msgs: array of packets to transmit
+ * @num_msgs: number of packets in @msgs
+ *
+ * Submit the complete packet array as one host transaction. This is distinct
+ * from looping over mipi_dsi_device_transfer(), as hosts may preserve packet
+ * grouping and ordering in a single DMA submission. Hosts without native
+ * support return -EOPNOTSUPP.
+ *
+ * Return: number of bytes submitted by the host, or a negative error code.
+ */
+ssize_t mipi_dsi_device_transfer_multi(struct mipi_dsi_device *dsi,
+				       const struct mipi_dsi_msg *msgs,
+				       size_t num_msgs)
+{
+	const struct mipi_dsi_host_ops *ops;
+	struct mipi_dsi_msg *batch;
+	size_t i;
+	ssize_t ret;
+
+	if (!dsi || !dsi->host || !msgs || !num_msgs)
+		return -EINVAL;
+
+	ops = dsi->host->ops;
+	if (!ops || !ops->transfer_multi)
+		return -EOPNOTSUPP;
+
+	batch = kcalloc(num_msgs, sizeof(*batch), GFP_KERNEL);
+	if (!batch)
+		return -ENOMEM;
+
+	for (i = 0; i < num_msgs; i++) {
+		struct mipi_dsi_packet packet;
+
+		if (!msgs[i].tx_buf || !msgs[i].tx_len ||
+		    msgs[i].rx_buf || msgs[i].rx_len ||
+		    msgs[i].channel != dsi->channel) {
+			ret = -EINVAL;
+			goto out;
+		}
+
+		batch[i] = msgs[i];
+		if (dsi->mode_flags & MIPI_DSI_MODE_LPM)
+			batch[i].flags |= MIPI_DSI_MSG_USE_LPM;
+
+		ret = mipi_dsi_create_packet(&packet, &batch[i]);
+		if (ret)
+			goto out;
+	}
+
+	ret = ops->transfer_multi(dsi->host, batch, num_msgs);
+out:
+	kfree(batch);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mipi_dsi_device_transfer_multi);
